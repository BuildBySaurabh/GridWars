# Backend environment. Copy to `.env` (git-ignored) and adjust.
# Every value below is a PLACEHOLDER. Never commit real secrets.

# --- Django ---------------------------------------------------------------
# NOTE: DJANGO_SETTINGS_MODULE is a real environment variable, not a .env entry (the module is
# chosen before this file is read). manage.py defaults to config.settings.dev; the ASGI entrypoint
# and scripts/start.sh default to config.settings.prod.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required in production (>= 32 characters). Dev falls back to an insecure built-in key.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
# Comma-separated host names this server answers to
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL is the source of truth for cell ownership) --------
DATABASE_URL=DATABASE_URL=postgres://gridwars:gridwars@127.0.0.1:5433/gridwars

# --- Redis (Django Channels layer + shared throttle cache) -------------------
# Leave empty in local dev to use the in-memory channel layer (single process only).
# Required in production. Use rediss:// for TLS-enabled providers.
REDIS_URL=redis://127.0.0.1:6379/0

# --- CORS / WebSocket origin allow-list (comma-separated, exact origins) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT --------------------------------------------------------------------
# Defaults to SECRET_KEY when empty. Use a separate value to rotate independently.
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256
# Guest token lifetime (default 7 days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=10080

# --- Rate limiting ----------------------------------------------------------
THROTTLE_JOIN_RATE=20/min
THROTTLE_CAPTURE_RATE=120/min
# Number of reverse proxies in front of the app (1 on most PaaS) so the real
# client IP is used for rate limiting. 0 = trust the socket address only.
NUM_PROXIES=0

# --- Real-time --------------------------------------------------------------
WS_AUTH_TIMEOUT_SECONDS=5
PRESENCE_TTL_SECONDS=75

# --- Production only (config.settings.prod) ---------------------------------
# Redirect HTTP -> HTTPS (disable only if your platform already does it and you see redirect loops)
SECURE_SSL_REDIRECT=true
# Seconds for HSTS; keep 0 until HTTPS is confirmed working, then raise (e.g. 31536000)
SECURE_HSTS_SECONDS=0
LOG_LEVEL=INFO
