# Frontend environment (Vite). Copy to `.env` for local overrides.
# Values are baked into the bundle at BUILD time and are public: never put secrets here.

# REST API base URL (include the /api prefix, no trailing slash needed)
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket endpoint. Use wss:// in production (required when the site is served over HTTPS).
VITE_WS_URL=ws://localhost:8000/ws/grid/
