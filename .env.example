# Used by docker-compose.yml only. LOCAL DEVELOPMENT defaults (they match backend/.env.example).
# Change every value for anything reachable from a network.
POSTGRES_USER=gridwars
POSTGRES_PASSWORD=gridwars
POSTGRES_DB=gridwars

# Django secret for the compose backend service (>= 32 characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# Origin(s) the browser app is served from (must match exactly, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
